# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env.example
!/.env*.erb

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
shared/log/*.log
shared/pids/*.pid
shared/pids/*.state

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore env configuration files
.env
.envrc
.rbenv-vars

# Ignore the files and folders generated through Webpack
/public/decidim-packs
/public/packs-test
/public/sw.js*

# Ignore node modules
/node_modules


# Ignore Tailwind configuration
/tailwind.config.js
/.playwright-mcp/
/mi-*.jpeg
/tmp/mi-design-kit/
/tour-*.jpeg

# GIS reference layers and large import GeoJSON files.
# These are operator-supplied reference data (54 MB+), not app source code.
# Keep the handoff .md docs tracked; ignore the data layers.
# See docs/operations/komsiluk-geojson-format.md for import source locations.
docs/handoff_decidim/gis_slojevi/
docs/handoff_decidim/*.geojson
data/geo/
# db/geo/ holds the SMALL canonical boundary import sources (MZ ~1.4MB, komšiluci)
# — version them so the import is reproducible from a clean checkout.
shared/log/**/*.log
shared/state/
# Original municipal GIS delivery stays on this server; track only derived resolver data.
/docs/assets/handoff_decidim/
