<% add_decidim_page_title(t("mi_open_source.page_title")) %>
<div class="wrapper">
  <article class="mi-surface mi-open-source" lang="<%= I18n.locale.to_s == "sr" ? "sr-Latn" : I18n.locale %>" aria-labelledby="open-source-title">
    <h1 id="open-source-title"><%= t("mi_open_source.title") %></h1>
    <p><%= t("mi_open_source.intro") %></p>
    <h2><%= t("mi_open_source.freedoms_title") %></h2>
    <p><%= t("mi_open_source.freedoms") %></p>
    <% if @release.published? %>
      <h2><%= t("mi_open_source.self_title") %></h2>
      <p><%= t("mi_open_source.self_intro") %></p>
      <ul>
        <li><%= link_to t("mi_open_source.app_link"), @release.repositories.fetch(:app) %></li>
        <li><%= link_to t("mi_open_source.engine_link"), @release.repositories.fetch(:engine) %></li>
      </ul>
      <p><%= link_to t("mi_open_source.installation_link"), "#{@release.repositories.fetch(:app)}/blob/main/docs/INSTALACIJA.md" %></p>
      <p><%= t("mi_open_source.installation_status") %></p>
      <p><%= t("mi_open_source.versions") %></p>
    <% else %>
      <h2><%= t("mi_open_source.draft_title") %></h2>
      <p><%= t("mi_open_source.draft") %></p>
    <% end %>
    <h2><%= t("mi_open_source.steps_title") %></h2>
    <ol>
      <% t("mi_open_source.steps").each do |step| %>
        <li><%= step %></li>
      <% end %>
    </ol>
    <p><%= t("mi_open_source.requirements") %></p>
    <h2><%= t("mi_open_source.services_title") %></h2>
    <p><%= t("mi_open_source.services") %></p>
    <p><%= mail_to "office@fondacijabijeljina.com", t("mi_open_source.contact"), subject: t("mi_open_source.contact_subject"), class: "mi-open-source__contact" %></p>
    <h2><%= t("mi_open_source.contribute_title") %></h2>
    <p><%= t("mi_open_source.contribute_intro") %> <%= mail_to "bojan@fondacijabijeljina.com" %>. <%= t("mi_open_source.contribute_after") %></p>
  </article>
</div>
