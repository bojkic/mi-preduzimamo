<%#
  "Pozovi komšije" — the slim strip in the omnipresent-banner slot.

  It shares that slot with the verify nudge and the two can never appear at the
  same time: the verify nudge is shown to a citizen with NO granted sms/postal
  authorization, this one only to a citizen who HAS one. Mutually exclusive by
  audience, not by ordering, so a phone never gets two stacked bars.

  Launch mode only, so it lapses by itself at the 14.10.2026 20:00 freeze with
  no deploy — the same rule the header pills and the bottom nav follow.

  Rendered hidden and revealed by mi-invite-nudge.js once it has checked the
  snooze, which is how the push offer behaves too: no flash of a bar that is
  about to hide itself, and no layout shift on every page load.

  WHY THIS LIVES IN THE HOST, unlike its sibling _verify_nudge, which is in the
  engine: everything it RENDERS is engine-owned, and its strings accordingly
  live in the engine's locales (decidim.bih.invite.nudge.*) so the Cyrillic is
  generated by `rake decidim_bih:cyrillize` rather than hand-written. But when
  it renders is a HOST decision — DecidimApp::LaunchMode, which layers the
  operator's Setting(launch, mode) override on top of the race window, and
  which the engine cannot see. That is the same split _mobile_bottom_nav
  already uses: host view, host schedule, engine copy.
%>
<%
  invite_nudge_hidden_prefixes = ["/admin", "/system", "/api"]

  invite_nudge_viewer =
    if user_signed_in? && respond_to?(:current_organization) && current_organization
      if current_user.respond_to?(:organization) && current_user.organization == current_organization
        current_user
      elsif current_user.respond_to?(:decidim_organization_id) && current_user.decidim_organization_id == current_organization.id
        current_user
      end
    end

  invite_nudge_path = Decidim::Bih.respond_to?(:invite_path) ? Decidim::Bih.invite_path : nil

  invite_nudge_tab = defined?(Decidim::Bih::INVITE_TAB) ? Decidim::Bih::INVITE_TAB : "pozovi"
  invite_nudge_on_invite_tab =
    invite_nudge_path.present? &&
    request.path == invite_nudge_path.split("?").first &&
    params[:tab].to_s == invite_nudge_tab

  invite_nudge_show =
    invite_nudge_viewer.present? &&
    invite_nudge_path.present? &&
    DecidimApp::LaunchMode.active?(current_organization) &&
    invite_nudge_hidden_prefixes.none? { |prefix| request.path.start_with?(prefix) } &&
    # Never on the invite tab itself: asking someone to open the page they are
    # already reading is pure noise. The tab is a QUERY parameter on the hub, so
    # comparing paths alone would silence the nudge across the whole hub —
    # tabla, trka, nagrade and all — which is three tabs too many.
    !invite_nudge_on_invite_tab &&
    # Byte-identical to the query the verify nudge just ran in this same
    # request, so Rails' per-request query cache answers it without a second
    # round trip. Keep the two spellings in step if either ever changes.
    Decidim::Authorization.where(user: invite_nudge_viewer, name: %w[sms postal_letter])
                          .where.not(granted_at: nil).exists?

  if invite_nudge_show
    invite_nudge_standing =
      if defined?(Decidim::Bih::Race::ViewerStanding)
        Decidim::Bih::Race::ViewerStanding.summary(invite_nudge_viewer, organization: current_organization)
      end

    # The deadline is READ from the race window, never typed: the strip must
    # not outlive the date it prints, and Config layers the per-org Setting
    # over the host initializer exactly as the leaderboard does.
    invite_nudge_deadline =
      begin
        window_to = Decidim::Bih::Race::Config.new(organization: current_organization).window_to
        # Already parsed in Europe/Sarajevo by Config; "14.10", the way the
        # campaign writes it, and no locale carries a day.month-only format.
        window_to.strftime("%-d.%-m") if window_to
      rescue StandardError => e
        Rails.logger.warn("[invite_nudge] race deadline unavailable: #{e.class}")
        nil
      end
  end
%>
<% if invite_nudge_show %>
  <div class="mi-invite-nudge"
       hidden
       data-invite-nudge
       data-invite-nudge-key="mi:invite-nudge:<%= invite_nudge_viewer.id %>"
       data-invite-nudge-days="7">
    <p class="mi-invite-nudge__text">
      <% if invite_nudge_deadline %>
        <strong class="mi-invite-nudge__lead"><%= t("decidim.bih.invite.nudge.race_lead", date: invite_nudge_deadline) %></strong>
      <% end %>
      <%# A zona is required for the ranked sentence, not merely nice to have:
          Standings#write_rows allows a nil zona, and "race.zone.#{nil}" is the
          PARENT key, which I18n answers with the whole {grad:, selo:} hash
          instead of falling back to the default. A rank with no league to be
          ranked in is not a sentence worth printing anyway. %>
      <% if invite_nudge_standing && invite_nudge_standing.zona.present? %>
        <%= t("decidim.bih.invite.nudge.ranked",
              komsiluk: invite_nudge_standing.display_name,
              rank: invite_nudge_standing.rank_in_zone,
              zone: t("decidim.bih.community_hub.race.zone.#{invite_nudge_standing.zona}",
                      default: invite_nudge_standing.zona.to_s)) %>
      <% else %>
        <%= t("decidim.bih.invite.nudge.unranked") %>
      <% end %>
    </p>
    <%= link_to t("decidim.bih.invite.nudge.action"), invite_nudge_path, class: "mi-invite-nudge__action" %>
    <%# Second way out of the strip: the standings themselves. /trka is a HOST
        route and this strip renders inside ENGINE controllers too (it sits in
        the omnipresent-banner slot of every page), where the bare helper is
        not in scope — `main_app.` is required, not stylistic. %>
    <%= link_to t("decidim.bih.invite.nudge.race_action"),
                main_app.launch_race_rules_path,
                class: "mi-invite-nudge__action mi-invite-nudge__action--race" %>
    <button type="button"
            class="mi-invite-nudge__close"
            data-invite-nudge-dismiss
            aria-label="<%= t("decidim.bih.invite.nudge.dismiss") %>">
      <%= icon "close-line", role: "img", "aria-hidden": true %>
    </button>
  </div>
<% end %>
