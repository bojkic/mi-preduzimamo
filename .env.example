# Primjer za sopstveno razvojno okruženje; nema produkcionih vrijednosti.
# Rails ne učitava ovaj fajl automatski. Predajte vrijednosti procesu svojim
# upravljačem okruženjem. Za testove koristite zasebne resurse i RAILS_ENV=test.
RAILS_ENV=development
RAILS_ALLOWED_HOSTS=localhost,127.0.0.1
DECIDIM_APPLICATION_NAME="MI preduzimamo — Vaša zajednica"
DECIDIM_MAILER_SENDER="MI preduzimamo <noreply@community.example.invalid>"
DECIDIM_BIH_PUBLIC_MOUNT_PATH=/biceriseno
DATABASE_URL=postgresql:///mi_preduzimamo_development
# Pokrenite sopstvenu razvojnu Redis instancu na izabranom portu.
REDIS_URL=redis://127.0.0.1:6381/0
# Generišite zasebne tajne za svako okruženje. Ne commitujte popunjene vrijednosti.
SECRET_KEY_BASE=
DECIDIM_API_JWT_SECRET=
# SMTP uključite tek kada podesite sopstvenu razvojnu prijemnu uslugu/provajdera.
# SMTP_ADDRESS=127.0.0.1
# SMTP_PORT=1025
# SMTP_DOMAIN=community.example.invalid
# SMTP_AUTHENTICATION=none
# SMTP_STARTTLS_AUTO=true
# MI_PUBLIC_SUPPORT_NAME=
# MI_PUBLIC_SUPPORT_ADDRESS=
# MI_PUBLIC_SUPPORT_EMAIL=
# MI_PUBLIC_SUPPORT_WEBSITE=
# Lokalni izvori se ne nasljeđuju. Putanje označavaju vaše pregledane podatke.
# MI_CITY_SOURCES_PATH=
# MI_CITIZEN_REFERENCE_PATH=
# MI_FOUNDATION_METADATA_PATH=
# MI_CIVIC_FACTS_DIR=
# MI_CIVIC_REVIEWED_HOSTS=
# MI_TRANSPORT_STOPS_PATH=
MILICA_REPORT_CHAT_SUBMISSION_ENABLED=false
DECIDIM_BIH_VIBER_BOT_ENABLED=false

# MI_REVIEWED_TRANSPORT_PATH=
# MI_TRANSPORT_PLACES_PATH=
# MI_TRANSPORT_CALENDAR_ID=

# Lokalno pregledani pravni tekstovi i javni kontakt vaše zajednice.
# MI_LEGAL_PAGES_PATH=

# Pregledane javne činjenice imenika i eksplicitno odobreni HTTPS hostovi.
# MI_DIRECTORY_FACTS_PATH=
# MI_DIRECTORY_FACTS_REVIEWED_HOSTS=

# Referentni lokalni adapter razgovora ostaje isključen bez izričite aktivacije.
MI_ENABLE_REFERENCE_CONCIERGE=false

# Vaši pregledani nazivi i padežni oblici mjesta.
# MI_PLACE_ALIASES_PATH=

# Opcioni izvor glasnika zajednice; nema naslijeđene lokalne URL adrese.
MI_GAZETTE_SOURCE_URL=

# Sopstveni pregledani budžet; bez podešavanja nema lokalnih budžetskih podataka.
# MI_BUDGET_TEXT_PATH=
# MI_BUDGET_YEAR=
# MI_BUDGET_CHECKED_ON=
# MI_BUDGET_SOURCE_URL=
# Opcioni pregledani ukupni iznos (decimalna tačka) i stranica tabela.
# Ne prepisujte međuzbir parsera kao ukupan budžet.
# MI_BUDGET_HEADLINE_TOTAL=
# MI_BUDGET_TABLE_PAGE=

# Stranica /otvoreni-kod ne prikazuje repo linkove prije potvrđene objave.
# Tek poslije anonimne provjere oba odobrena repozitorijuma uključiti true.
MI_OPEN_SOURCE_PUBLISHED=false
MI_OPEN_SOURCE_APP_URL=
MI_OPEN_SOURCE_ENGINE_URL=

# Sopstveni pregledani dokaz pristupa tačnom report-case AI modelu.
# Bez eksplicitne putanje nema potvrđenog pristupa; fajl ne ide u Git.
# REPORT_CASE_MODEL_ACCESS_RECEIPT=

# Opcioni kontakt operatera za HTTP zahtjeve kolektora/probe lokalnih izvora.
# Bez postavke ili uz neispravnu adresu nema From zaglavlja; nema LF fallback-a.
# MI_SOURCE_CONTACT_EMAIL=

# Opciono: granice vaše zajednice zapad,sjever,istok,jug. Prazno znači bez lokalne granice.
MI_GEOCODER_VIEWBOX=
MI_GEOCODER_COUNTRY_CODES=ba

# Slug sopstvenog procesa za prijedloge; prazno ne daje odredište.
# MI_FLAGSHIP_PROCESS_SLUG=prijedlozi-zajednice

# Slike asistenta pripadaju host aplikaciji; prazne vrijednosti ih skrivaju.
# MI_ASSISTANT_IMAGE_PATH=/mi/milica/wave.gif
# MI_ASSISTANT_STATIC_IMAGE_PATH=/mi/milica/wave.jpg

# Pregledani lokalni nazivi stanica i posebni sufiksi; nema naslijeđene mape.
# MI_STATION_LABELS_PATH=
